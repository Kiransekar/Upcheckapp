# Force LF for all text files across all platforms (prevents Windows CRLF vs Linux LF hash mismatches in EAS builds)
* text=auto eol=lf

# Source files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Native Android files
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.pro text eol=lf
gradlew text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - do not alter
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.keystore binary
*.so binary
*.aar binary
*.dll binary
*.exe binary
*.pdf binary
