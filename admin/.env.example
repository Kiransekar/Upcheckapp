# Both are SERVER-ONLY. Never prefix either with NEXT_PUBLIC_ — that would
# ship the admin key to every visitor's browser.

# The Upcheck API root, including the /api prefix, no trailing slash.
UPCHECK_API_URL="https://api.upcheck.in/api"

# The same value as ADMIN_API_KEY on the Render backend.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY="generate-a-long-random-string"
